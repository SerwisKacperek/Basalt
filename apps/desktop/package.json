{
  "name": "@basalt/desktop",
  "version": "0.0.1",
  "description": "Basalt Desktop",
  "author": "Basalt",
  "main": "dist/main.js",
  "private": true,
  "scripts": {
    "build:web": "cross-env OUT_DIR=../desktop/dist/web bun run --filter @basalt/web build:electron",
    "build:main": "electron-vite build",
    "build:sources": "bun run build:web && bun run build:main",
    "build": "bun run build:sources && electron-builder",
    "start": "bun run build:sources && electron .",
    "dev:renderer": "bun --filter @basalt/web dev:electron",
    "dev:main": "wait-on http://localhost:5174 && cross-env VITE_DEV_SERVER_URL=http://localhost:5174 electron-vite dev",
    "dev": "concurrently -k -n renderer,main -c blue,magenta \"bun run dev:renderer\" \"bun run dev:main\"",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-rebuild -f -w better-sqlite3 || true",
    "check-types": "tsc --noEmit",
    "lint": "eslint ."
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@basalt/api": "*",
    "@basalt/core": "*",
    "@basalt/db": "*",
    "@basalt/domain": "*",
    "better-sqlite3": "^12.4.1",
    "dotenv": "^16",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "latest",
    "@types/node": "^25.6.0",
    "concurrently": "^9",
    "cross-env": "^7",
    "electron": "^41.5.0",
    "electron-builder": "^25.0.0",
    "electron-rebuild": "^3.2.9",
    "electron-vite": "^4",
    "typescript": "^5",
    "vite": "^8.0.3",
    "wait-on": "^9"
  },
  "build": {
    "appId": "com.basalt.app",
    "productName": "Basalt",
    "files": [
      "dist/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
